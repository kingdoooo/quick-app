[Platform]
base_domain = example.com
account_id = 000000000000
region = us-east-1
routing_table = ApplicationWebRouterStack-subdomain-mapping
# 首个平台管理员邮箱（部署脚本幂等写入 site-admins 表）。
# 之后的管理员增删在控制台完成，不需要改这里重部署。
admin_seed =

[Cognito]
user_pool_id =
domain =
site_client_id =
mcp_client_id =
# 二期 M4：key-proxy 用的 client_credentials 客户端。
# **M1 不创建**——client_credentials 只能授 resource server 的 custom scope，
# 空 scope 会被 Cognito 跨字段校验拒绝。M4 建 resource server 时一并创建并回填。
machine_client_id =

[DSQL]
cluster_endpoint =

[Deployer]
jobs_table = site-deploy-jobs
sites_table = site-sites
admins_table = site-admins
artifacts_bucket = site-artifacts-{account_id}
frontend_bucket = site-frontend-{account_id}
state_machine_arn =
edge_role_arn =

[MCP]
endpoint_url =

# 可选：给平台专用 user pool 联邦一个 OIDC IdP。
# 平台对 IdP 无感——只要 IdP 能给 email claim 即可（飞书适配器与
# Okta/Azure AD 等标准 IdP 走同一条配置路径，见 DEPLOY.md ①）。
# 留空则只建 pool 与 client，联邦另行手工配置。
#
# ⚠️ 接入 IdP 前必读——**email 的可信度是整个授权模型的地基**：
# owner / collaborators / allowed_users / 会话 claim 全以 email 为键。
# 联邦映射进 Cognito 的 email **默认是 unverified**（AWS 官方行为）。
# 因此对 IdP 的要求不只是"能给 email claim"，而是：
#   ① 邮箱由管理员/组织分配，终端用户**不能自行修改**；
#   ② 邮箱在组织内唯一，不会被回收后重新分配给他人。
# 不满足这两条的 IdP（如允许自助注册并自设邮箱的公共 IdP）绝不能接——
# 攻击者把自己的 email 改成某站点 owner 的地址即可继承其全部权限。
[IdP]
provider_name =
issuer =
client_id =
client_secret =
scopes = openid email profile
# 是否把 IdP 的 email_verified claim 映射进用户档案（默认 true）。
# IdP 不发这个 claim 时映射是 no-op，不会导致登录失败，所以保持 true 无风险。
# 注意它的效力边界：该属性是**粘性**的（源 claim 消失时 Cognito 不回退），
# 且只表示"IdP 声明已验证"，不代表"用户不能自改邮箱"——上面的 ①② 才是硬要求。
map_email_verified = true

# 是否**强制要求** email 已验证才签发会话 / 授权 MCP 调用（默认 true）。
# 落在两处：auth 服务的 /callback 与 MCP 的 _caller_email()，都是 fail-closed
# （claim 缺失、"false"、类型不对一律拒）。飞书 OIDC 适配器实测会发
# email_verified=true，所以默认开不会锁死用户。
#
# **只在接入确实不提供该 claim 的 IdP 时才设 false**，代价是这道技术防线消失、
# 完全退回上面 ①② 的选型约束。设为 false 后请在变更记录里写明原因。
# 部署时通过 Lambda 环境变量 REQUIRE_EMAIL_VERIFIED 下发。
require_email_verified = true

# 告警通知收件人。**真实邮箱只写进 gitignored 的 config.ini，不进本文件。**
# 也可用环境变量 SB_ALERT_EMAIL 覆盖（CI 场景）。
#
# deploy_auth.py 会幂等收敛：metric filter → SNS topic → email 订阅 → alarm。
# ⚠️ email 订阅**必须由收件人手工点确认链接**——脚本只能创建订阅，
# 无法代为确认。未确认时 alarm 照样进 ALARM 而无人收到通知，
# 所以脚本会把 PendingConfirmation 显式报告为「未完成」。
[Alerting]
email =

# 二期 M3 控制台（panel）。deploy_panel.py 从这里取值。
[Panel]
ops_log_table = site-ops-log
session_codes_table = site-session-codes
# 前端静态资源的版本前缀：S3 platform/console/{console_version}/
# 每次前端改动递增，旧版本保留以便回滚（与站点前端的版本化上传同模式）。
console_version = v1

# ── API Key（二期 M4，**可选组件**）─────────────────────────────────
# **整段不配置 = 平台只允许 OAuth 一条认证路径**，这是推荐的默认。
# 不配置时：不建 Cognito resource server / machine client、不部署 key-proxy、
# 不注册 mcp 子域、deploy_agentcore.py 不把 machine client 加进 allowedClients、
# 也不放行 X-SB-On-Behalf-Of 头。于是即使有人拿到一把 Key 也在**网关层**被拒，
# 不经过任何业务代码（spec §5.1.1 的"组件门禁"）。
#
# API Key 只认证"谁在调部署 MCP"，与访问已部署站点的 require_login /
# allowed_users 是**两套独立的认证平面**——它碰不到站点访问。
#
# 需要给"只能配静态 Header 的客户端"（如 Quick Desktop Remote MCP）用时才配：
# [ApiKey]
# # 已部署组件后的应急开关：false = key-proxy 立即拒绝全部 Key（怀疑泄漏时
# # 一键关闸，不必拆组件/重部 AgentCore）。它是副门禁，不替代上面的组件门禁。
# enabled = true
# keys_table = site-api-keys
# # client_credentials 必须有 resource server + scope（不能用空 scope 建 client）
# resource_server_id = site-builder-mcp
# scope = invoke
