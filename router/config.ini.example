# Application Web Router Configuration Template
# Copy this file to config.ini and modify the REQUIRED settings

# ============================================================================
# AWS Account Settings (REQUIRED - Must be modified)
# ============================================================================
[AWS]
# Your AWS account ID (12 digits)
account_id = 123456789012
# AWS region for deployment (must be us-east-1 for Lambda@Edge)
region = us-east-1

# ============================================================================
# CloudFront Settings (REQUIRED - Must be modified)
# ============================================================================
[CloudFront]
# Your custom domain with wildcard (e.g., *.example.com)
# This should match your Route53 hosted zone or DNS provider
domain_name = *.example.com
# ACM certificate ARN in us-east-1 region for your domain
# Create certificate in ACM console and copy the ARN here
certificate_arn = arn:aws:acm:us-east-1:123456789012:certificate/your-cert-id
# Fallback origin. The edge function rewrites the origin on every normal path,
# but CloudFront resolves this domain BEFORE invoking the origin-request event —
# so it MUST be a resolvable domain. Using a non-resolvable value (e.g. anything
# under the reserved .invalid TLD) makes every request fail with
# "502 CloudFront wasn't able to resolve the origin domain name" before the edge
# function ever runs, so it cannot even return its own 404/403.
# Keep example.com unless you have a reason to change it.
default_origin = example.com
# Origin request policy name (optional, can keep default)
origin_request_policy_name = ApplicationWebRouterPolicy
# NOTE: CloudFront caching is hard-disabled in stack.py (CACHING_DISABLED).
# The origin-request edge function performs per-request auth; caching would
# serve authenticated responses to unauthenticated users. No TTL settings.

# ============================================================================
# DynamoDB Settings (OPTIONAL - Can keep defaults)
# ============================================================================
[DynamoDB]
# DynamoDB table name for subdomain mappings
table_name = subdomain-mapping
# DynamoDB region (should match AWS region)
region = us-east-1

# ============================================================================
# Lambda Settings (OPTIONAL - Can keep defaults)
# ============================================================================
[Lambda]
# IAM role name for Lambda execution
# This role will be created by CDK if it doesn't exist
execution_role_name = lambda-execution-role
# Lambda memory size in MB (128-10240)
memory_size = 128
# Lambda timeout in seconds (max 30 for Lambda@Edge origin-request)
timeout_seconds = 5

# ============================================================================
# Lambda@Edge Settings (OPTIONAL - Can keep defaults)
# ============================================================================
[LambdaEdge]
# Lambda@Edge function name for origin request
origin_request_function_name = application-web-router

# ============================================================================
# Lambda Test Settings (OPTIONAL - For testing only)
# ============================================================================
[LambdaTest]
# ECR repository name for test Lambda images
ecr_repository = expressjs-demo
# Function name prefix for test deployments
function_prefix = expressjs-demo

# ============================================================================
# CDK Stack Settings (OPTIONAL - Can keep defaults)
# ============================================================================
[CDK]
# CDK stack name
# 注意：如果修改stack名称，请确保新名称包含"WebRouterStack"字符串
# 否则可能会出现权限不足的情况（IAM策略基于*WebRouterStack*模式匹配）
stack_name = ApplicationWebRouterStack
# Stack description
stack_description = CloudFront-based dynamic subdomain routing system using Lambda@Edge and DynamoDB for backend service discovery

# ============================================================================
# Site Builder Settings (REQUIRED for site-builder integration)
# ============================================================================
[SiteBuilder]
# Shared private S3 bucket holding site static assets under sites/<site_id>/...
# The edge function reads it with SigV4; the bucket must be in us-east-1.
frontend_bucket = site-frontend-123456789012
# Base domain for site subdomains (must match the CloudFront wildcard domain,
# e.g. domain_name = *.example.com -> base_domain = example.com).
# auth.<base_domain> hosts the login service.
base_domain = example.com
# JWT secret is NOT stored here: it is read at deploy time from the SSM
# SecureString parameter /site-builder/jwt-secret (us-east-1). Create it with:
#   aws ssm put-parameter --name /site-builder/jwt-secret --type SecureString \
#     --value "$(python3 -c 'import secrets;print(secrets.token_hex(32))')" \
#     --region us-east-1
# spec §3.5：会话必须来自可信企业 IdP。存量会话没有 idp claim，
# 所以首次部署配 false；切到平台专用 pool 且全体用户重新登录后置 true
# （M1 的完成条件——停在 false 等于这道防线没生效）。
# 两项都是必填：stack.py 直接读，缺键会在 synth 时报 NoOptionError（响亮失败），
# 而不是把占位符字面量部署出去（那等于静默关闭这道防线）。
require_idp_claim = false
# Cognito 里 IdP 的 provider name，逗号分隔（如 Feishu 或 Okta,Feishu）。
# 必须与 site-builder/config.ini [IdP] provider_name 一致。
trusted_idps =

# ============================================================================
# Resource Tags (OPTIONAL - Recommended for cost tracking)
# ============================================================================
[Tags]
# Project name - used for grouping resources
project = site-builder
# Environment (e.g., production, staging, development)
environment = production
# Managed by (e.g., cdk, terraform, manual)
managed_by = cdk
# Cost center or team name for billing
cost_center = engineering
